# Frontend build args for DEPLOYED images — used by ../build.sh frontend
#
# These are NOT the same as frontend/.env. That file is your local-dev config
# (VITE_LAUNCH_MODE=local, localhost URLs). VITE_ vars are inlined into the
# bundle at build time, so building a deploy image from .env would publish a
# frontend that tries to reach localhost from the user's browser — it builds and
# pushes cleanly, then fails only once someone loads the page.
#
# Copy to .env.release (gitignored) and fill in your deploy values:
#   cp frontend/.env.release.example frontend/.env.release

# "remote" for a deployed image. build.sh refuses to --push a "local" build.
VITE_LAUNCH_MODE="remote"

# Public wss:// URL of cr8_engine.
VITE_WEBSOCKET_URL="wss://engine.example.com"

# Discord webhook for in-app feedback. Treat as a secret — anyone holding it can
# post to your channel.
VITE_DISCORD_WEBHOOK_URL=""

# WebRTC signalling server for Blender viewport streaming.
VITE_WEBRTC_SIGNALING_SERVER_URL="wss://signal.example.com"

# TURN server for NAT traversal (needed for VastAI and other cloud GPUs).
# Format: turn://username:password@host:port  (URL-encode special chars in the
# password). Contains a credential — treat as a secret.
VITE_TURN_SERVER="turn://user:password@host:3478"
