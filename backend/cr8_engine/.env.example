# B.L.A.Z.E AI Agent Configuration
OPENROUTER_API_KEY=
AI_PROVIDER=
OLLAMA_BASE_URL=
AI_MODEL_NAME=

# Blender Configuration
# Path to the Blender executable (required for local mode)
BLENDER_EXECUTABLE_PATH=

# Deployment Mode: "local" (subprocess) or "remote" (VastAI)
LAUNCH_MODE=local

# VastAI Configuration (required when LAUNCH_MODE=remote)
# See TEMPLATE_SETUP.md for how to create the template
# API key from https://console.vast.ai/account/
VASTAI_API_KEY=
# Template hash ID from https://cloud.vast.ai/templates/ (bundles image, onstart, env vars, SSH)
# This is the hash_id string (e.g., "4e17788f74f075dd9aab7d0d4427968f"), not the numeric ID
VASTAI_TEMPLATE_HASH_ID=
# SSH keys are generated automatically at startup and attached via VastAI API
# Max concurrent Blender processes per VastAI instance
MAX_USERS_PER_INSTANCE=3
# Seconds to keep an empty instance alive before destroying it
INSTANCE_IDLE_TIMEOUT=300

# Which VastAI provisioning engine handles instance lifecycle: "legacy"
# (flat JSON state, startup-only reconciliation — current default, unchanged
# behavior) or "v2" (Postgres-backed, continuous reconciliation, guaranteed-
# destroy ledger — app/services/provisioning/). Keep on "legacy" until v2 has
# been shadow-validated in production against your VastAI account; see the
# rollout section of the provisioning re-architecture plan before flipping.
PROVISIONING_ENGINE=legacy

# v2 engine only. Two-letter VastAI/ISO country codes to restrict GPU offer
# search to (latency) — confirmed against VastAI's own API docs, which
# document geolocation as a country-code filter, not a continent/"EU" literal.
# Default centers on Germany (matches a Hetzner Falkenstein engine/signaller
# deployment) plus nearby low-latency EU. Set to an empty string to disable.
PROVISIONING_ALLOWED_COUNTRIES=DE,NL,PL,AT,CH,BE,CZ,DK,LU,FR

# v2 engine only. A launch (offer accepted -> Blender fully up) at or under
# this many seconds gets its physical machine recorded as "known fast";
# future launches for the same GPU tier try those machines first.
PROVISIONING_FAST_LAUNCH_THRESHOLD=120

# How long the engine waits for a render to come back from Blender before
# giving up. Must clear the addon's own Cycles time limit (600s) plus the
# upload, or a render that was going to succeed gets abandoned mid-flight.
RENDER_TIMEOUT_SECONDS=1800

# PostgreSQL Database (required for remote mode)
# Uses asyncpg driver for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://cr8:password@localhost:5432/cr8

# RustFS object storage (required for remote mode)
# RustFS ships no SDK of its own — it is S3-compatible and accessed via boto3.
# The S3 API listens on port 9000 (the Console on 9001 is NOT the API).
#
# Two endpoints, because presigned URLs sign the Host header: a URL signed for
# one hostname fails with SignatureDoesNotMatch if sent to the other.
#   PUBLIC   — where the browser uploads to (through the Cloudflare tunnel).
#   INTERNAL — where VastAI instances read/write (over the VPN, bypassing the
#              tunnel's 100MB request body cap). Defaults to PUBLIC when unset,
#              which is what you want for local dev with no VPN.
RUSTFS_PUBLIC_ENDPOINT=https://s3.cr8-xyz.art
RUSTFS_INTERNAL_ENDPOINT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=cr8-xyz
